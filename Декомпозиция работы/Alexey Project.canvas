		{"id":"2e3237d1fdcf66b4","type":"text","text":"### Выгрузка данных","x":440,"y":1360,"width":250,"height":50,"color":"6"},
		{"id":"6d53f681cfddbf1f","type":"text","text":"Сделать 3 режима:\n1) Режим обычных линий\n2) Режим корректирующих линий. \n3) Режим вымерки углов.","x":900,"y":920,"width":250,"height":200,"color":"1"},
		{"id":"e49fe120a233feb5","type":"text","text":"Сделать режим построения углов по трём точкам меньше 180 градусов","x":1402,"y":765,"width":250,"height":90,"color":"1"},
		{"id":"29de459602188f6b","type":"text","text":"Сделать переход в режим углов","x":1399,"y":658,"width":250,"height":60,"color":"1"},
		{"id":"f542435b4d3392f9","type":"text","text":"Сделать отображение построения углов ","x":1405,"y":1090,"width":250,"height":60,"color":"1"},
		{"id":"17778b7b74fc10a7","type":"text","text":"Сделать переход в режим обычных линий","x":1399,"y":890,"width":250,"height":60,"color":"1"},
		{"id":"eec3e1fc7925b1d3","type":"text","text":"### Обработка данных\n","x":440,"y":-200,"width":250,"height":60,"color":"6"},
		{"id":"7ad77e10f756df6f","type":"text","text":"Добавить кнопку смены режима","x":1405,"y":990,"width":250,"height":60,"color":"1"},
		{"id":"5ee7b03b61d457e0","type":"text","text":"Сделать переход в режим корректирующих линий","x":1405,"y":1200,"width":250,"height":68,"color":"1"},
		{"id":"ae7730c75c5ec2f7","type":"text","text":"Сделать выгрузку углов как 25-30","x":864,"y":1355,"width":250,"height":60,"color":"1"},
		{"id":"69cb768df7743cdb","type":"text","text":"### Загрузка данных","x":440,"y":-820,"width":250,"height":60,"color":"6"},
		{"id":"056405713d503c38","type":"text","text":"Сделать возможность загружать старые данные и сразу отображать их. ","x":780,"y":-849,"width":250,"height":118,"color":"1"},
		{"id":"ab01dea58bd99a20","type":"text","text":"Сделать загрузку фотографий","x":780,"y":-940,"width":250,"height":60,"color":"4"},
		{"id":"8b039d154e8d0f60","type":"text","text":"Изменить хранилище и добавить переменные для новых режимов. ","x":817,"y":-102,"width":250,"height":97,"color":"4"},
		{"id":"b8911a6e6fa01aed","type":"text","text":"Добавить смену текста в зависимости от активного режима","x":810,"y":-333,"width":250,"height":102,"color":"1"},
		{"id":"412388527d2565aa","type":"text","text":"Добавить обработку кнопки смены режима","x":817,"y":-200,"width":250,"height":60,"color":"4"},
		{"id":"ce37ea78b311b478","type":"text","text":"Добавить условия выполнения кнопок в зависимости от режима\n","x":780,"y":-497,"width":250,"height":116,"color":"1"},
		{"id":"7c18e79fcb074194","type":"text","text":"Сделать методы внесения изменений в хранилище новых режимов.","x":780,"y":29,"width":250,"height":100,"color":"4"},
		{"id":"87ab339079729045","type":"text","text":"Сделать сохранение segments, углов и correctSegments на картинке.","x":860,"y":1440,"width":250,"height":119,"color":"1"},
		{"id":"cf13b170c78dd2ea","type":"text","text":"Сделать сохранение segments, углов и correctSegments в techFile.","x":860,"y":1600,"width":250,"height":119,"color":"1"},
		{"id":"82adb6477dfe987e","x":1180,"y":-312,"width":250,"height":162,"color":"1","type":"text","text":"Разбить модели на несколько и унести в модели всю логику взаимодействия с их элементами, оставить чисто методы Change-ей."}
