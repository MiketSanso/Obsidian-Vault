		{"id":"821356bf9e51818a","type":"text","text":"### UI паттерны проектирования","x":-580,"y":-280,"width":250,"height":120,"color":"6"},
		{"id":"d449d9b2a77dd295","type":"text","text":"### Общая система\n","x":-210,"y":-220,"width":250,"height":60,"color":"6"},
		{"id":"a6c4578dc7c2a396","type":"text","text":"При смене фото","x":1280,"y":340,"width":250,"height":60,"color":"4"},
