		{"id":"617a0f39d09bfc23","x":1068,"y":293,"width":250,"height":60,"type":"text","text":"Описать задачи, которые выполнял **В целом**."},
		{"id":"70ea43198fcd033b","x":1068,"y":587,"width":250,"height":97,"type":"text","text":"Выбрать проекты и описать задачи на каждом из проектов."},
		{"id":"b519056060d99cf4","x":1075,"y":18,"width":250,"height":60,"type":"text","text":"Выбрать место работы, года работы."},
		{"id":"10cb4d6a37a8c4f6","x":1075,"y":161,"width":250,"height":60,"type":"text","text":"Описать команду и взаимодействие с ними"},
