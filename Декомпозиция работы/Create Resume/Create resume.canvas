	"nodes":[
		{"id":"31100f929096a3db","x":-210,"y":45,"width":250,"height":135,"color":"1","type":"text","text":"# Create resume"},
		{"id":"c77c0348ccabbe88","x":-210,"y":240,"width":250,"height":63,"type":"text","text":"Прошлое место работы"},
		{"id":"f10d0435d3d8644e","x":-840,"y":920,"width":250,"height":63,"type":"text","text":"Hybrid casual"},
		{"id":"b227c59191b068c2","x":560,"y":606,"width":250,"height":60,"type":"text","text":"Midcore "},
		{"id":"8ec4378c7be5736e","x":1445,"y":478,"width":250,"height":60,"type":"text","text":"Проект 1"},
