		{"id":"8897649fed01c690","type":"text","text":"### Отображение данных","x":440,"y":390,"width":250,"height":81,"color":"6"},
		{"id":"6d53f681cfddbf1f","type":"text","text":"Сделать 3 режима:\n1) Режим обычных линий\n2) Режим корректирующих линий. \n3) Режим вымерки углов.","x":900,"y":920,"width":250,"height":200,"color":"4"},
		{"id":"1578b8e1ccdd9b0e","type":"text","text":"## Архитектура скриптов","x":-635,"y":1125,"width":315,"height":75,"color":"6"},
