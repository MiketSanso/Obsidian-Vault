		{"id":"247713e7a8cf9622","type":"text","text":"## Presenters","x":864,"y":3265,"width":173,"height":50,"color":"6"},
		{"id":"29de459602188f6b","type":"text","text":"Сделать переход в режим углов","x":1518,"y":716,"width":250,"height":60,"color":"4"},
		{"id":"e49fe120a233feb5","type":"text","text":"Сделать видимость построения углов по трём точкам меньше 180 градусов","x":1660,"y":800,"width":250,"height":90,"color":"4"},
		{"id":"ae6fb92c9be83049","type":"text","text":"При выборе какой-то определённой калибровочной линии (если она уже была нарисована) выделить её другим цветом.","x":1725,"y":900,"width":250,"height":180,"color":"4"},
		{"id":"17778b7b74fc10a7","type":"text","text":"Сделать переход в режим обычных линий","x":1620,"y":1100,"width":250,"height":60,"color":"4"},
		{"id":"7ad77e10f756df6f","type":"text","text":"Добавить кнопку смены режима","x":1518,"y":1180,"width":250,"height":60,"color":"4"},
		{"id":"5ee7b03b61d457e0","type":"text","text":"Сделать переход в режим корректирующих линий","x":1360,"y":1260,"width":250,"height":68,"color":"4"},
		{"id":"d449d9b2a77dd295","type":"text","text":"### Общая система\n","x":-334,"y":-580,"width":250,"height":60,"color":"6"},
